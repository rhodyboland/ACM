static void createMainUI()
{
    lv_obj_t * mainScreen = lv_obj_create(NULL);
    lv_scr_load(mainScreen);
    lv_obj_add_style(mainScreen, &styleScreenBg, 0);

    // Top Bar (optional)
    lv_obj_t * topBar = lv_obj_create(mainScreen);
    lv_obj_set_size(topBar, 480, 50);
    lv_obj_align(topBar, LV_ALIGN_TOP_MID, 0, 0);
    lv_obj_set_style_pad_all(topBar, 10, 0);
    lv_obj_set_style_bg_opa(topBar, LV_OPA_50, 0);
    lv_obj_set_style_bg_color(topBar, lv_color_hex(0x2F2F2F), 0);

    lv_obj_t * titleLbl = lv_label_create(topBar);
    lv_label_set_text(titleLbl, "ACM Control");
    lv_obj_align(titleLbl, LV_ALIGN_CENTER, 0, 0);

    // Main container: vertical
    lv_obj_t * mainContainer = lv_obj_create(mainScreen);
    lv_obj_set_size(mainContainer, 480, 750);
    lv_obj_align(mainContainer, LV_ALIGN_BOTTOM_MID, 0, 0);
    lv_obj_set_style_pad_all(mainContainer, 10, 0);

    lv_obj_set_layout(mainContainer, LV_LAYOUT_FLEX);
    lv_obj_set_flex_flow(mainContainer, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(mainContainer,
                          LV_FLEX_ALIGN_START,
                          LV_FLEX_ALIGN_CENTER,
                          LV_FLEX_ALIGN_CENTER);

    // Data panels (Battery, Solar, Sensors)
    // Each call returns a “Value” label pointer. We'll store that in e.g. g_lblBatteryMain
    createDataPanel(mainContainer, "Battery", &g_lblBatteryMain, batteryDetail_event_cb);
    createDataPanel(mainContainer, "Solar",   &g_lblSolarMain,   solarDetail_event_cb);
    createDataPanel(mainContainer, "Sensors", &g_lblSensorMain,  sensorDetail_event_cb);

    // Channels & Inverter
    lv_obj_t * controls = lv_obj_create(mainContainer);
    lv_obj_set_size(controls, 460, LV_SIZE_CONTENT);
    lv_obj_set_style_pad_all(controls, 10, 0);
    lv_obj_set_layout(controls, LV_LAYOUT_FLEX);
    lv_obj_set_flex_flow(controls, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(controls,
                          LV_FLEX_ALIGN_START,
                          LV_FLEX_ALIGN_CENTER,
                          LV_FLEX_ALIGN_CENTER);

    // Low Current heading
    lv_obj_t * lblLC = lv_label_create(controls);
    lv_label_set_text(lblLC, "Low Current Outputs");
    lv_obj_set_style_text_font(lblLC, &lv_font_montserrat_18, 0);

    // Container for 8 LC channels
    lv_obj_t * lcContainer = lv_obj_create(controls);
    lv_obj_set_size(lcContainer, 440, LV_SIZE_CONTENT);
    lv_obj_set_style_pad_all(lcContainer, 10, 0);
    lv_obj_set_layout(lcContainer, LV_LAYOUT_FLEX);
    lv_obj_set_flex_flow(lcContainer, LV_FLEX_FLOW_ROW_WRAP);
    lv_obj_set_flex_align(lcContainer,
                          LV_FLEX_ALIGN_START,
                          LV_FLEX_ALIGN_CENTER,
                          LV_FLEX_ALIGN_CENTER);

    for (int i=0; i<8; i++){
        char label[16];
        snprintf(label, sizeof(label), "LC%d", i+1);
        createChannelButton(lcContainer, label);
    }

    // Medium Current heading
    lv_obj_t * lblMC = lv_label_create(controls);
    lv_label_set_text(lblMC, "Medium Current Outputs");
    lv_obj_set_style_text_font(lblMC, &lv_font_montserrat_18, 0);

    lv_obj_t * mcContainer = lv_obj_create(controls);
    lv_obj_set_size(mcContainer, 440, LV_SIZE_CONTENT);
    lv_obj_set_style_pad_all(mcContainer, 10, 0);
    lv_obj_set_layout(mcContainer, LV_LAYOUT_FLEX);
    lv_obj_set_flex_flow(mcContainer, LV_FLEX_FLOW_ROW_WRAP);
    lv_obj_set_flex_align(mcContainer,
                          LV_FLEX_ALIGN_START,
                          LV_FLEX_ALIGN_CENTER,
                          LV_FLEX_ALIGN_CENTER);

    for (int i=0; i<2; i++){
        char label[16];
        snprintf(label, sizeof(label), "MC%d", i+1);
        createChannelButton(mcContainer, label);
    }

    createInverterButton(mcContainer);
}

// Creates a data panel with Title + "Value" label, returning a pointer to the label
static lv_obj_t* createDataPanel(lv_obj_t *parent,
                                 const char *title,
                                 lv_obj_t **valueLabelRef,
                                 lv_event_cb_t event_cb)
{
    lv_obj_t * panel = lv_obj_create(parent);
    lv_obj_set_size(panel, 460, 80);
    lv_obj_add_style(panel, &stylePanel, 0);

    if(event_cb) {
        lv_obj_add_flag(panel, LV_OBJ_FLAG_CLICKABLE);
        lv_obj_add_event_cb(panel, event_cb, LV_EVENT_CLICKED, NULL);
    }

    // Title
    lv_obj_t * lblTitle = lv_label_create(panel);
    lv_label_set_text(lblTitle, title);
    lv_obj_add_style(lblTitle, &stylePanelTitle, 0);
    lv_obj_align(lblTitle, LV_ALIGN_TOP_LEFT, 10, 5);

    // Value label
    lv_obj_t * lblValue = lv_label_create(panel);
    lv_label_set_text(lblValue, ""); // will fill later
    lv_obj_add_style(lblValue, &stylePanelValue, 0);
    lv_obj_align(lblValue, LV_ALIGN_BOTTOM_RIGHT, -10, -5);

    if(valueLabelRef) {
        *valueLabelRef = lblValue;
    }
    return panel;
}

