// -----------------------------------------------------------------------------
static lv_style_t styleScreenBg;
static lv_style_t stylePanel;
static lv_style_t stylePanelTitle;
static lv_style_t stylePanelValue;
static lv_style_t styleBtnOff;
static lv_style_t styleBtnOn;
