// -----------------------------------------------------------------------------
// Setup & Loop
// -----------------------------------------------------------------------------

void setup()
{
    Serial.begin(115200);
    Serial.println("ACMV2_LCD_REALTIME start");

    // 1) Initialize panel device
    ESP_Panel* panel = new ESP_Panel();
    panel->init();
    panel->begin();

    // 2) Initialize LVGL
    lvgl_port_init(panel->getLcd(), panel->getTouch());

    // 3) Build UI
    lvgl_port_lock(-1);
    {
        // --- Initialize styles ---
        // Dark background with a subtle gradient
        lv_style_init(&styleScreenBg);
        lv_style_set_bg_color(&styleScreenBg, lv_color_hex(0x1B1C1E));
        lv_style_set_bg_grad_color(&styleScreenBg, lv_color_hex(0x333333));
        lv_style_set_bg_grad_dir(&styleScreenBg, LV_GRAD_DIR_VER);
        lv_style_set_bg_opa(&styleScreenBg, LV_OPA_COVER);

        // Panel style (for Battery/Solar/Sensors “cards”)
        lv_style_init(&stylePanel);
        lv_style_set_radius(&stylePanel, 12);
        lv_style_set_bg_color(&stylePanel, lv_color_hex(0x3A506B));
        lv_style_set_bg_grad_color(&stylePanel, lv_color_hex(0x5B728A));
        lv_style_set_bg_grad_dir(&stylePanel, LV_GRAD_DIR_VER);
        lv_style_set_bg_opa(&stylePanel, LV_OPA_COVER);
        lv_style_set_pad_all(&stylePanel, 10);

        // Panel title
        lv_style_init(&stylePanelTitle);
        lv_style_set_text_font(&stylePanelTitle, &lv_font_montserrat_20);

        // Panel value
        lv_style_init(&stylePanelValue);
        lv_style_set_text_font(&stylePanelValue, &lv_font_montserrat_24);
        lv_style_set_text_color(&stylePanelValue, lv_color_white());

        // Button OFF
        lv_style_init(&styleBtnOff);
        lv_style_set_radius(&styleBtnOff, 10);
        lv_style_set_bg_grad_dir(&styleBtnOff, LV_GRAD_DIR_VER);
        lv_style_set_bg_color(&styleBtnOff, lv_color_hex(0x777777));
        lv_style_set_bg_grad_color(&styleBtnOff, lv_color_hex(0xAAAAAA));

        // Button ON
        lv_style_init(&styleBtnOn);
        lv_style_set_radius(&styleBtnOn, 10);
        lv_style_set_bg_grad_dir(&styleBtnOn, LV_GRAD_DIR_VER);
        lv_style_set_bg_color(&styleBtnOn, lv_palette_main(LV_PALETTE_GREEN));
        lv_style_set_bg_grad_color(&styleBtnOn, lv_color_hex(0x98FB98));

        // Error
        lv_style_init(&styleBtnError);
        lv_style_set_radius(&styleBtnError, 10);
        lv_style_set_bg_grad_dir(&styleBtnError, LV_GRAD_DIR_VER);
        lv_style_set_bg_color(&styleBtnError, lv_palette_main(LV_PALETTE_RED));
        lv_style_set_bg_grad_color(&styleBtnError, lv_color_hex(0xFF8C00));

        // Build main screen UI
        createMainUI();

        // Optionally rotate display 90 degrees
        lv_disp_t *disp = lv_disp_get_default();
        lv_disp_set_rotation(disp, LV_DISP_ROT_90);

        // Do an initial UI update to show the placeholders
        updateAllUI();
    }
    lvgl_port_unlock();

    Serial.println("Setup complete");
}

void loop()
{
    // Suppose in your real code, you update g_batteryVoltage, etc. here
    // Then call updateAllUI() each time they change.

    delay(1000);
    Serial.println("IDLE...");
}

