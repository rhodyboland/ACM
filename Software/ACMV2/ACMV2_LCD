static void batteryDetail_event_cb(lv_event_t * e)
{
    openBatteryDetailPopup();
}

// Creates (or re-creates) the battery detail popup
static void openBatteryDetailPopup()
{
    // If already open, just refresh
    if (g_batteryOverlay) {
        refreshBatteryDetailUI();
        return;
    }

    // 1) Create a full-screen overlay
    g_batteryOverlay = lv_obj_create(lv_scr_act());
    lv_obj_set_size(g_batteryOverlay, LV_PCT(100), LV_PCT(100));
    lv_obj_set_style_bg_color(g_batteryOverlay, lv_color_black(), 0);
    lv_obj_set_style_bg_opa(g_batteryOverlay, LV_OPA_TRANSP, 0);
    lv_obj_clear_flag(g_batteryOverlay, LV_OBJ_FLAG_SCROLLABLE);
    fadeInOverlay(g_batteryOverlay);

    // 2) Main detail panel (centered)
    g_batteryDetailPanel = lv_obj_create(g_batteryOverlay);
    lv_obj_set_size(g_batteryDetailPanel, 440, 430); // Enough space for arc + 2-column data
    lv_obj_set_style_radius(g_batteryDetailPanel, 12, 0);
    lv_obj_set_style_bg_color(g_batteryDetailPanel, lv_color_hex(0x2F2F2F), 0);
    lv_obj_set_style_bg_opa(g_batteryDetailPanel, LV_OPA_80, 0);
    lv_obj_align(g_batteryDetailPanel, LV_ALIGN_CENTER, 0, 0);

    // Make the panel a vertical flex layout
    lv_obj_set_layout(g_batteryDetailPanel, LV_LAYOUT_FLEX);
    lv_obj_set_flex_flow(g_batteryDetailPanel, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_flex_align(g_batteryDetailPanel,
                          LV_FLEX_ALIGN_CENTER,  // main alignment (vertical)
                          LV_FLEX_ALIGN_CENTER,  // cross alignment (horizontal)
                          LV_FLEX_ALIGN_START);
    lv_obj_set_style_pad_row(g_batteryDetailPanel, 10, 0); // add vertical spacing

    // 3) Title at the top
    lv_obj_t * lblTitle = lv_label_create(g_batteryDetailPanel);
    lv_label_set_text(lblTitle, "Battery Detail");
    lv_obj_set_style_text_font(lblTitle, &lv_font_montserrat_20, 0);

    // 4) Arc at the top (double-wide ~2 columns, e.g. 300×200)
    g_batteryArc = lv_arc_create(g_batteryDetailPanel);
    lv_obj_set_size(g_batteryArc, 300, 200); // Adjust as desired
    // set arc range, angles, etc. or call your createBatteryArc() + updateBatteryArc() here
    lv_obj_clear_flag(g_batteryArc, LV_OBJ_FLAG_CLICKABLE);

    // 5) Data container below the arc
    // We'll arrange 5 data cards (Voltage, Current, Temp, AvgCell, SOC) in 2 columns (row wrap).
    lv_obj_t * dataContainer = lv_obj_create(g_batteryDetailPanel);
    lv_obj_set_size(dataContainer, 400, 140); // Enough height so no scrolling
    lv_obj_set_style_bg_opa(dataContainer, LV_OPA_0, 0);

    // 2-column grid: row wrap with ~2 columns wide. Each card ~180 wide × 60 tall.
    lv_obj_set_layout(dataContainer, LV_LAYOUT_FLEX);
    lv_obj_set_flex_flow(dataContainer, LV_FLEX_FLOW_ROW_WRAP);
    lv_obj_set_flex_align(dataContainer,
                          LV_FLEX_ALIGN_START,   // main direction
                          LV_FLEX_ALIGN_CENTER,  // cross direction
                          LV_FLEX_ALIGN_START);
    lv_obj_set_style_pad_row(dataContainer, 10, 0);     // vertical spacing between rows
    lv_obj_set_style_pad_column(dataContainer, 10, 0);  // horizontal spacing between columns

    // Create your data cards. Each calls createDetailDataCard(... &g_lblBattVoltage, etc.).
    createDetailDataCard(dataContainer, "Voltage",   &g_lblBattVoltage);
    createDetailDataCard(dataContainer, "Current",   &g_lblBattCurrent);
    createDetailDataCard(dataContainer, "Temp",      &g_lblBattTemp);
    createDetailDataCard(dataContainer, "Avg Cell",  &g_lblBattAvgCell);
    createDetailDataCard(dataContainer, "SOC(%)",    &g_lblBattPercent);

    // 6) Close button at the bottom
    lv_obj_t * closeBtn = lv_btn_create(g_batteryDetailPanel);
    lv_obj_set_size(closeBtn, 80, 40);
    lv_obj_t * closeLbl = lv_label_create(closeBtn);
    lv_label_set_text(closeLbl, "Close");
    lv_obj_center(closeLbl);

    // On close => remove overlay & references
    lv_obj_add_event_cb(closeBtn, [](lv_event_t* e){
        lv_obj_del(g_batteryOverlay);
        g_batteryOverlay = nullptr;
        g_batteryDetailPanel = nullptr;
        g_batteryArc = nullptr;
        g_lblBattVoltage = nullptr;
        g_lblBattCurrent = nullptr;
        g_lblBattTemp = nullptr;
        g_lblBattAvgCell = nullptr;
        g_lblBattPercent = nullptr;
    }, LV_EVENT_CLICKED, nullptr);

    // Populate everything from your existing data
    refreshBatteryDetailUI();
}



// Updates the battery detail UI
static void refreshBatteryDetailUI()
{
    if(!g_batteryDetailPanel) return; // not open

    // Update arc
    if(g_batteryArc) {
        updateBatteryArc(g_batteryArc, (int)g_batteryPercent);
    }

    // Update labels
    if(g_lblBattVoltage) {
        static char buf[32];
        snprintf(buf, sizeof(buf), "%.2f V", g_batteryVoltage);
        lv_label_set_text(g_lblBattVoltage, buf);
    }
    if(g_lblBattCurrent) {
        static char buf[32];
        snprintf(buf, sizeof(buf), "%.2f A", g_batteryCurrent);
        lv_label_set_text(g_lblBattCurrent, buf);
    }
    if(g_lblBattTemp) {
        static char buf[32];
        snprintf(buf, sizeof(buf), "%.1f C", g_batteryTemp);
        lv_label_set_text(g_lblBattTemp, buf);
    }
    if(g_lblBattAvgCell) {
        static char buf[32];
        snprintf(buf, sizeof(buf), "%.2f V", g_batteryAvgCell);
        lv_label_set_text(g_lblBattAvgCell, buf);
    }
    if(g_lblBattPercent) {
        static char buf[32];
        snprintf(buf, sizeof(buf), "%.0f", g_batteryPercent);
        lv_label_set_text(g_lblBattPercent, buf);
    }
}

// Creates a large battery arc
static lv_obj_t* createBatteryArc(lv_obj_t* parent, int batteryValue)
{
    lv_obj_t * arc = lv_arc_create(parent);
    // 1) Make sure the arc is in normal mode (not reverse/symmetric)
    lv_arc_set_mode(arc, LV_ARC_MODE_NORMAL);

    // 2) Rotate the entire arc by 180°, so 0..180 is visually the top half
    lv_arc_set_rotation(arc, 180);

    // 3) Set the background arc to 0..180
    //    This means the arc's "full range" is a semi-circle along the top.
    lv_arc_set_bg_angles(arc, 0, 180);

    // remove click
    lv_obj_clear_flag(arc, LV_OBJ_FLAG_CLICKABLE);

    // style
    lv_obj_set_style_arc_width(arc, 25, LV_PART_INDICATOR);
    lv_obj_set_style_arc_width(arc, 25, LV_PART_MAIN);

    // set initial
    updateBatteryArc(arc, batteryValue);
    return arc;
}

static void updateBatteryArc(lv_obj_t* arc, int batteryValue)
{
    lv_arc_set_value(arc, batteryValue);

    int16_t endAngle = 180 + (int16_t)(1.8f * batteryValue);
    lv_arc_set_angles(arc, 180, endAngle);

    // color logic
    lv_color_t arcColor = lv_palette_main(LV_PALETTE_GREEN);
    if (batteryValue < 20) arcColor = lv_palette_main(LV_PALETTE_RED);
    else if (batteryValue < 50) arcColor = lv_palette_main(LV_PALETTE_YELLOW);

    lv_obj_set_style_arc_color(arc, arcColor, LV_PART_INDICATOR);
    lv_obj_set_style_arc_color(arc, lv_color_hex(0xaaaaaa), LV_PART_MAIN);
}

