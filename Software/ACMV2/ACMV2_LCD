    createDetailDataCard(dataContainer, "Power",     &g_lblSolarPower);
    createDetailDataCard(dataContainer, "State",     &g_lblSolarState);

    // Close
    lv_obj_t * closeBtn = lv_btn_create(g_solarDetailPanel);
    lv_obj_set_size(closeBtn, 80, 40);
    lv_obj_align(closeBtn, LV_ALIGN_BOTTOM_MID, 0, -10);

    lv_obj_t * closeLbl = lv_label_create(closeBtn);
    lv_label_set_text(closeLbl, "Close");
    lv_obj_center(closeLbl);

    lv_obj_add_event_cb(closeBtn, [](lv_event_t* e){
        lv_obj_del(g_solarOverlay);
        g_solarOverlay      = nullptr;
        g_solarDetailPanel  = nullptr;
        g_lblSolarVoltage   = nullptr;
        g_lblSolarCurrent   = nullptr;
        g_lblSolarPower     = nullptr;
        g_lblSolarState     = nullptr;
    }, LV_EVENT_CLICKED, nullptr);

    refreshSolarDetailUI();
}

static void refreshSolarDetailUI()
{
    if(!g_solarDetailPanel) return;

    if(g_lblSolarVoltage) {
        static char buf[32];
        snprintf(buf, sizeof(buf), "%.1f V", g_solarVoltage);
        lv_label_set_text(g_lblSolarVoltage, buf);
    }
    if(g_lblSolarCurrent) {
        static char buf[32];
        snprintf(buf, sizeof(buf), "%.1f A", g_solarCurrent);
        lv_label_set_text(g_lblSolarCurrent, buf);
    }
    if(g_lblSolarPower) {
        static char buf[32];
        snprintf(buf, sizeof(buf), "%.1f W", g_solarPower);
        lv_label_set_text(g_lblSolarPower, buf);
    }
    if(g_lblSolarState) {
        lv_label_set_text(g_lblSolarState, g_solarState);
    }
}

// -----------------------------------------------------------------------------
