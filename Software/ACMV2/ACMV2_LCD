// -----------------------------------------------------------------------------

static void sensorDetail_event_cb(lv_event_t * e)
{
    openSensorDetailPopup();
}

static void openSensorDetailPopup()
{
    if(g_sensorOverlay) {
        refreshSensorDetailUI();
        return;
    }

    g_sensorOverlay = lv_obj_create(lv_scr_act());
    lv_obj_set_size(g_sensorOverlay, LV_PCT(100), LV_PCT(100));
    lv_obj_set_style_bg_color(g_sensorOverlay, lv_color_black(), 0);
    lv_obj_set_style_bg_opa(g_sensorOverlay, LV_OPA_TRANSP, 0);
    lv_obj_clear_flag(g_sensorOverlay, LV_OBJ_FLAG_SCROLLABLE);
    fadeInOverlay(g_sensorOverlay);

    g_sensorDetailPanel = lv_obj_create(g_sensorOverlay);
    lv_obj_set_size(g_sensorDetailPanel, 420, 240);
    lv_obj_set_style_radius(g_sensorDetailPanel, 12, 0);
    lv_obj_set_style_bg_color(g_sensorDetailPanel, lv_color_hex(0x2F2F2F), 0);
    lv_obj_set_style_bg_opa(g_sensorDetailPanel, LV_OPA_80, 0);
    lv_obj_align(g_sensorDetailPanel, LV_ALIGN_CENTER, 0, 0);

    lv_obj_t * lblTitle = lv_label_create(g_sensorDetailPanel);
    lv_label_set_text(lblTitle, "Sensor Detail");
    lv_obj_set_style_text_font(lblTitle, &lv_font_montserrat_20, 0);
    lv_obj_align(lblTitle, LV_ALIGN_TOP_MID, 0, 5);

    // A small container for data
    lv_obj_t * dataContainer = lv_obj_create(g_sensorDetailPanel);
    lv_obj_set_size(dataContainer, 400, 120);
    lv_obj_set_style_bg_opa(dataContainer, LV_OPA_0, 0);
    lv_obj_set_layout(dataContainer, LV_LAYOUT_FLEX);
    lv_obj_set_flex_flow(dataContainer, LV_FLEX_FLOW_ROW_WRAP);
    lv_obj_set_flex_align(dataContainer,
                          LV_FLEX_ALIGN_START,
                          LV_FLEX_ALIGN_CENTER,
                          LV_FLEX_ALIGN_CENTER);
    lv_obj_align(dataContainer, LV_ALIGN_TOP_MID, 0, 40);

    createDetailDataCard(dataContainer, "Int Temp", &g_lblSensorTemp);

    // Close
    lv_obj_t * closeBtn = lv_btn_create(g_sensorDetailPanel);
    lv_obj_set_size(closeBtn, 80, 40);
    lv_obj_align(closeBtn, LV_ALIGN_BOTTOM_MID, 0, -10);

    lv_obj_t * closeLbl = lv_label_create(closeBtn);
    lv_label_set_text(closeLbl, "Close");
    lv_obj_center(closeLbl);

    lv_obj_add_event_cb(closeBtn, [](lv_event_t* e){
        lv_obj_del(g_sensorOverlay);
        g_sensorOverlay = nullptr;
        g_sensorDetailPanel = nullptr;
        g_lblSensorTemp = nullptr;
    }, LV_EVENT_CLICKED, nullptr);

    refreshSensorDetailUI();
}

static void refreshSensorDetailUI()
{
    if(!g_sensorDetailPanel) return;

    if(g_lblSensorTemp) {
        static char buf[32];
        snprintf(buf, sizeof(buf), "%.1f C", g_sensorTemp);
        lv_label_set_text(g_lblSensorTemp, buf);
    }
}

// -----------------------------------------------------------------------------
// Data Card Helper (blue gradient style card + a label reference)
// -----------------------------------------------------------------------------

static lv_obj_t* createDetailDataCard(lv_obj_t * parent,
                                      const char *title,
                                      lv_obj_t **valueLabelRef)
{
    lv_obj_t * card = lv_obj_create(parent);
    lv_obj_set_size(card, 160, 60);
    lv_obj_add_style(card, &stylePanel, 0);

    // Title
    lv_obj_t * lblTitle = lv_label_create(card);
    lv_label_set_text(lblTitle, title);
    lv_obj_add_style(lblTitle, &stylePanelTitle, 0);
    lv_obj_align(lblTitle, LV_ALIGN_TOP_LEFT, 5, 5);

    // Value
    lv_obj_t * lblValue = lv_label_create(card);
    lv_label_set_text(lblValue, "");
    lv_obj_add_style(lblValue, &stylePanelValue, 0);
    lv_obj_align(lblValue, LV_ALIGN_BOTTOM_RIGHT, -5, -5);

    if(valueLabelRef) {
        *valueLabelRef = lblValue;
    }
    return card;
}

// -----------------------------------------------------------------------------
// Channels & Inverter
// -----------------------------------------------------------------------------

static lv_obj_t* createChannelButton(lv_obj_t *parent, const char *labelText)
{
    lv_obj_t * btn = lv_btn_create(parent);
    lv_obj_set_size(btn, 110, 55);
    lv_obj_set_style_radius(btn, 10, 0);

    lv_obj_add_style(btn, &styleBtnOff, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_add_style(btn, &styleBtnOn,  LV_PART_MAIN | LV_STATE_CHECKED);

    // Label
    lv_obj_t * lbl = lv_label_create(btn);
    lv_label_set_text(lbl, labelText);
    lv_obj_center(lbl);

    // Start OFF
    lv_obj_clear_state(btn, LV_STATE_CHECKED);

    // Event
    lv_obj_add_event_cb(btn, channelBtn_event_cb, LV_EVENT_CLICKED, (void*)labelText);
    return btn;
}

static lv_obj_t* createInverterButton(lv_obj_t *parent)
{
    lv_obj_t * btn = lv_btn_create(parent);
    lv_obj_set_size(btn, 110, 55);
    lv_obj_set_style_radius(btn, 10, 0);

    lv_obj_add_style(btn, &styleBtnOff, LV_PART_MAIN | LV_STATE_DEFAULT);
    lv_obj_add_style(btn, &styleBtnOn,  LV_PART_MAIN | LV_STATE_CHECKED);

    lv_obj_t * lbl = lv_label_create(btn);
    lv_label_set_text(lbl, "Inverter");
    lv_obj_center(lbl);

    // Start OFF
    lv_obj_clear_state(btn, LV_STATE_CHECKED);

    lv_obj_add_event_cb(btn, inverterBtn_event_cb, LV_EVENT_CLICKED, NULL);
    return btn;
}

static void channelBtn_event_cb(lv_event_t * e)
{
    lv_obj_t * btn = lv_event_get_target(e);
    const char* label = (const char*)lv_event_get_user_data(e);

    bool isOn = lv_obj_has_state(btn, LV_STATE_CHECKED);
    if(isOn) {
        // turn off
        lv_obj_clear_state(btn, LV_STATE_CHECKED);
        isOn = false;
    } else {
        // turn on
        lv_obj_add_state(btn, LV_STATE_CHECKED);
        isOn = true;
    }
    Serial.printf("%s => %s\n", label, isOn ? "ON" : "OFF");
}

static void inverterBtn_event_cb(lv_event_t * e)
{
    lv_obj_t * btn = lv_event_get_target(e);
    bool isOn = lv_obj_has_state(btn, LV_STATE_CHECKED);

    if(isOn) {
        // turn off
        lv_obj_clear_state(btn, LV_STATE_CHECKED);
        Serial.println("Inverter => OFF");
    } else {
        // turn on
        lv_obj_add_state(btn, LV_STATE_CHECKED);
        Serial.println("Inverter => ON");
    }
}

// -----------------------------------------------------------------------------
// Fade-in Overlay
// -----------------------------------------------------------------------------

static void fadeInOverlay(lv_obj_t * overlay)
{
    lv_obj_set_style_bg_opa(overlay, LV_OPA_TRANSP, 0);

    lv_anim_t a;
    lv_anim_init(&a);
    lv_anim_set_var(&a, overlay);
    lv_anim_set_time(&a, 300);
    lv_anim_set_exec_cb(&a, [](void* obj, int32_t v){
        lv_obj_set_style_bg_opa((lv_obj_t*)obj, (lv_opa_t)v, 0);
    });
    lv_anim_set_values(&a, 0, 150);
    lv_anim_start(&a);
}

// -----------------------------------------------------------------------------
// Real-time UI Update
// -----------------------------------------------------------------------------

// Called whenever your data changes:
static void updateAllUI()
{
    // 1) Update main screen labels
    // e.g. "12.6V / 85%"
    if(g_lblBatteryMain) {
        static char buf[64];
        snprintf(buf, sizeof(buf), "%.2fV / %.0f%%", g_batteryVoltage, g_batteryPercent);
        lv_label_set_text(g_lblBatteryMain, buf);
    }
    if(g_lblSolarMain) {
        static char buf[64];
        snprintf(buf, sizeof(buf), "%.1fV / %.1fW", g_solarVoltage, g_solarPower);
        lv_label_set_text(g_lblSolarMain, buf);
    }
    if(g_lblSensorMain) {
        static char buf[64];
        snprintf(buf, sizeof(buf), "Int Temp: %.1fC", g_sensorTemp);
        lv_label_set_text(g_lblSensorMain, buf);
    }

    // 2) If detail popups are open, refresh them
    refreshBatteryDetailUI();
    refreshSolarDetailUI();
    refreshSensorDetailUI();
}
